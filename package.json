  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.1",
    "expo-constants": "~57.0.21",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.19",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.23",
    "expo-status-bar": "~57.0.0",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "5.6.0",
    "react-native-web": "^0.21.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "~19.2.0",
    "firebase-tools": "^15.32.1",
    "react-test-renderer": "^19.2.3",
    "typescript": "~5.9.2"
  }
}
